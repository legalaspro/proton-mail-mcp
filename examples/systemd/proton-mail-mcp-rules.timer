# OFF by default. Nothing enables this timer for you.
# Applies rules to INBOX only; Drafts, Sent and all other sources are refused.
[Unit]
Description=Process one capped batch of reviewed folder rules every five minutes

[Timer]
OnCalendar=*:0/5
Persistent=false
Unit=proton-mail-mcp-rules.service

[Install]
WantedBy=timers.target
